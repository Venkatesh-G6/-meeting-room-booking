# ================================================
# Facility Scheduler — Environment Variables
# ================================================
# Copy this file to .env
# Fill in real values
# NEVER commit .env to git
# ================================================

# ── Database ──────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/roombooking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# ── Spring Profile ────────────────────────────
# dev   = no auth, local dev
# local = real Entra ID auth
# prod  = full production
SPRING_PROFILES_ACTIVE=dev

# ── Microsoft Entra ID ────────────────────────
# Required for local and prod profiles
# Get from Azure Portal → App Registrations
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_APP_ID_URI=api://your-client-id-here

# ── Teams Bot ─────────────────────────────────
# Required for Teams integration
# Get from Azure Portal → Azure Bot Service
BOT_APP_ID=your-bot-app-id-here
BOT_APP_PASSWORD=your-bot-app-password-here

# ── Frontend ──────────────────────────────────
# dev        = show dev login button
# production = Microsoft login only
VITE_ENV=dev

# ── Docker only ───────────────────────────────
# Used in docker-compose.yml
COMPOSE_PROJECT_NAME=facilityscheduler
