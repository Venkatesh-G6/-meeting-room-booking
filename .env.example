# Database
DB_URL=jdbc:mysql://localhost:3306/roombooking_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-db-password-here

# Azure AD (Microsoft Entra ID)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_APP_ID_URI=api://your-app-id-here

# Active Spring profile: dev (no auth) or prod (JWT required)
SPRING_PROFILES_ACTIVE=dev
